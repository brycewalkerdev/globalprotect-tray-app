<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GlobalProtect Tray</vendor>
  <vendor_url>https://github.com/brycewalkerdev/globalprotect-tray-app</vendor_url>
  <action id="io.github.brycewalkerdev.globalprotect-tray-app.helper">
    <description>Connect or disconnect the GlobalProtect VPN</description>
    <message>Authentication is required to control the GlobalProtect VPN</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/globalprotect-tray/globalprotect-tray-helper</annotate>
  </action>
</policyconfig>
